<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background before Compose draws: matches LightBackground / DarkBackground in theme/Color.kt. -->
    <color name="window_background">#FFF8F6F2</color>

    <!-- Light base; values-night/themes.xml switches to the dark Material theme so the first frame is not white. -->
    <style name="Theme.SummitRead" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
